#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# AP3000M: periodic FM350 RNDIS WAN watchdog

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/ap3000m-fm350-watch daemon
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
